diff --git a/target/linux/bmips/dts/bcm3383-technicolor-tc7200u.dts b/target/linux/bmips/dts/bcm3383-technicolor-tc7200u.dts
new file mode 100644
index 0000000000..c462055b88
--- /dev/null
+++ b/target/linux/bmips/dts/bcm3383-technicolor-tc7200u.dts
@@ -0,0 +1,103 @@
+// SPDX-License-Identifier: GPL-2.0
+/dts-v1/;
+
+#include "bcm3384_viper.dtsi"
+
+/ {
+	compatible = "technicolor,tc7200u", "brcm,bcm3384-viper", "brcm,bcm33843-viper";
+	model = "Technicolor TC7200.U";
+
+	chosen {
+		bootargs = "console=ttyS0,115200 earlycon";
+		stdout-path = &uart0;
+	};
+};
+
+&uart0 {
+	reg = <0x14e00500 0x18>;
+	interrupt-parent = <&periph_intc>;
+	interrupts = <2>;
+	clocks = <&periph_clk>;
+	status = "okay";
+};
+/* TC7200.U SPI NOR probe. Disabled after invalid boot/panic. RAM-boot only. */
+&{/ubus} {
+        spi: spi@14e01000 {
+                compatible = "brcm,bcm6328-hsspi";
+                reg = <0x14e01000 0x600>;
+
+                #address-cells = <1>;
+                #size-cells = <0>;
+
+                interrupt-parent = <&periph_intc>;
+                interrupts = <7>;
+
+                clocks = <&periph_clk>;
+                clock-names = "hsspi";
+
+                status = "disabled";
+
+                flash@0 {
+                        compatible = "jedec,spi-nor";
+                        reg = <0>;
+                        spi-max-frequency = <10000000>;
+                };
+        };
+};
+
+/* Temporary TC7200.U NAND probe node. RAM-boot test only. Do not flash. */
+&{/ubus} {
+	iop_intc: iop_intc@14e00050 {
+		compatible = "brcm,bcm3380-l2-intc";
+		reg = <0x14e00050 0x4 0x14e00054 0x4>;
+
+		interrupt-controller;
+		#interrupt-cells = <1>;
+
+		interrupt-parent = <&cpu_intc>;
+		interrupts = <5>;
+	};
+
+	nand: nand@14e02200 {
+		compatible = "brcm,nand-bcm6368", "brcm,brcmnand-v4.0", "brcm,brcmnand";
+		reg-names = "nand", "nand-int-base", "nand-cache";
+		reg = <0x14e02200 0x180>, <0x14e000f0 0x10>, <0x14e02600 0x200>;
+
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		interrupt-parent = <&periph_intc>;
+		interrupts = <3>;
+
+		status = "okay";
+
+		nandcs@0 {
+			compatible = "brcm,nandcs";
+			reg = <0>;
+			nand-ecc-strength = <1>;
+			nand-ecc-step-size = <512>;
+
+			#address-cells = <1>;
+			#size-cells = <1>;
+		};
+	};
+
+};
+/* Temporary TC7200.U GENET fixed-link diagnostic. RAM-boot only. */
+&{/ubus} {
+	ethernet_test: ethernet@12c00000 {
+		compatible = "brcm,genet-v1";
+		reg = <0x12c00000 0x4000>;
+
+		interrupt-parent = <&periph_intc>;
+		interrupts = <16>, <17>;
+
+		phy-mode = "rgmii";
+		status = "okay";
+
+		fixed-link {
+			speed = <1000>;
+			full-duplex;
+		};
+	};
+};
diff --git a/target/linux/bmips/dts/bcm3384_viper.dtsi b/target/linux/bmips/dts/bcm3384_viper.dtsi
new file mode 100644
index 0000000000..eb2a9c6ed6
--- /dev/null
+++ b/target/linux/bmips/dts/bcm3384_viper.dtsi
@@ -0,0 +1,109 @@
+// SPDX-License-Identifier: GPL-2.0
+/ {
+	#address-cells = <1>;
+	#size-cells = <1>;
+	compatible = "brcm,bcm3384-viper", "brcm,bcm33843-viper";
+
+	memory@0 {
+		device_type = "memory";
+
+		/* Typical ranges.  The bootloader should fill these in. */
+		reg = <0x06000000 0x02000000>,
+		      <0x0e000000 0x02000000>;
+	};
+
+	cpus {
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		/* 1/2 of the CPU core clock (standard MIPS behavior) */
+		mips-hpt-frequency = <300000000>;
+
+		cpu@0 {
+			compatible = "brcm,bmips4350";
+			device_type = "cpu";
+			reg = <0>;
+		};
+	};
+
+	cpu_intc: cpu_intc {
+		#address-cells = <0>;
+		compatible = "mti,cpu-interrupt-controller";
+
+		interrupt-controller;
+		#interrupt-cells = <1>;
+	};
+
+	clocks {
+		periph_clk: periph_clk {
+			compatible = "fixed-clock";
+			#clock-cells = <0>;
+			clock-frequency = <54000000>;
+		};
+	};
+
+	aliases {
+		uart0 = &uart0;
+	};
+
+	ubus {
+		#address-cells = <1>;
+		#size-cells = <1>;
+
+		compatible = "brcm,ubus", "simple-bus";
+		ranges;
+		/* No dma-ranges on Viper. */
+
+		periph_intc: periph_intc@14e00048 {
+			compatible = "brcm,bcm3380-l2-intc";
+			reg = <0x14e00048 0x4 0x14e0004c 0x4>,
+			      <0x14e00350 0x4 0x14e00354 0x4>;
+
+			interrupt-controller;
+			#interrupt-cells = <1>;
+
+			interrupt-parent = <&cpu_intc>;
+			interrupts = <4>;
+		};
+
+		cmips_intc: cmips_intc@151f8048 {
+			compatible = "brcm,bcm3380-l2-intc";
+			reg = <0x151f8048 0x4 0x151f804c 0x4>;
+
+			interrupt-controller;
+			#interrupt-cells = <1>;
+
+			interrupt-parent = <&periph_intc>;
+			interrupts = <30>;
+			brcm,int-map-mask = <0xffffffff>;
+		};
+
+		uart0: serial@14e00520 {
+			compatible = "brcm,bcm6345-uart";
+			reg = <0x14e00520 0x18>;
+			interrupt-parent = <&periph_intc>;
+			interrupts = <2>;
+			clocks = <&periph_clk>;
+			status = "disabled";
+		};
+
+		ehci0: usb@15400300 {
+			compatible = "brcm,bcm3384-ehci", "generic-ehci";
+			reg = <0x15400300 0x100>;
+			big-endian;
+			interrupt-parent = <&periph_intc>;
+			interrupts = <41>;
+			status = "disabled";
+		};
+
+		ohci0: usb@15400400 {
+			compatible = "brcm,bcm3384-ohci", "generic-ohci";
+			reg = <0x15400400 0x100>;
+			big-endian;
+			no-big-frame-no;
+			interrupt-parent = <&periph_intc>;
+			interrupts = <40>;
+			status = "disabled";
+		};
+	};
+};
