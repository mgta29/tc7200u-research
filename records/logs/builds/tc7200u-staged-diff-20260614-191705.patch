diff --git a/target/linux/bmips/patches-6.12/998-bmips-tc7200u-gmac-init.patch b/target/linux/bmips/patches-6.12/998-bmips-tc7200u-gmac-init.patch
new file mode 100644
index 0000000000..2956c86d64
--- /dev/null
+++ b/target/linux/bmips/patches-6.12/998-bmips-tc7200u-gmac-init.patch
@@ -0,0 +1,124 @@
+--- a/arch/mips/bmips/setup.c
++++ b/arch/mips/bmips/setup.c
+@@ -9,6 +9,7 @@
+ 
+ #include <linux/init.h>
+ #include <linux/bitops.h>
++#include <linux/delay.h>
+ #include <linux/memblock.h>
+ #include <linux/ioport.h>
+ #include <linux/kernel.h>
+@@ -144,6 +145,105 @@
+ 	bmips_smp_enabled = 0;
+ }
+ 
++
++#define TC7200U_GPIO_MUX_REG		((void __iomem *)CKSEG1ADDR(0x14e001c0))
++#define TC7200U_CLK_CTRL_LOW		((void __iomem *)CKSEG1ADDR(0x14e00004))
++#define TC7200U_CLK_CTRL_HIGH		((void __iomem *)CKSEG1ADDR(0x14e00008))
++#define TC7200U_GMAC_MISC_CTRL          ((void __iomem *)CKSEG1ADDR(0x14e000ec))
++#define TC7200U_SOFT_RESETB_LOW		((void __iomem *)CKSEG1ADDR(0x14e0008c))
++#define TC7200U_GMAC_CMD		((void __iomem *)CKSEG1ADDR(0x12c00070))
++#define TC7200U_UNIMAC_IF0_BASE		((void __iomem *)CKSEG1ADDR(0x12c00600))
++#define TC7200U_UNIMAC_IF1_BASE		((void __iomem *)CKSEG1ADDR(0x12c02600))
++
++static void tc7200u_bcm3383_gmac_init(void)
++{
++	u32 val;
++
++	/*
++	 * Vendor bcm3383_pinmux_select(10):
++	 * bcm3383_mux_data[10] = { word = 0, mask = 7, shift = 15, val = 5 }
++	 */
++	val = __raw_readl(TC7200U_GPIO_MUX_REG);
++	val &= ~(0x7 << 15);
++	val |= (0x5 << 15);
++	__raw_writel(val, TC7200U_GPIO_MUX_REG);
++
++	/*
++	 * Vendor bcm3383_init_gmac():
++	 * clear soft_resetb_low bits 6 and 8
++	 * enable clk_ctrl_low bit 6
++	 * enable clk_ctrl_high bit 8
++	 * wait 200 ms
++	 * set soft_resetb_low bits 6 and 8
++	 */
++	val = __raw_readl(TC7200U_SOFT_RESETB_LOW);
++	val &= ~((1 << 6) | (1 << 8));
++	__raw_writel(val, TC7200U_SOFT_RESETB_LOW);
++
++	val = __raw_readl(TC7200U_CLK_CTRL_LOW);
++	val |= (1 << 6);
++	__raw_writel(val, TC7200U_CLK_CTRL_LOW);
++
++	val = __raw_readl(TC7200U_CLK_CTRL_HIGH);
++	val |= (1 << 8);
++	__raw_writel(val, TC7200U_CLK_CTRL_HIGH);
++
++       val = __raw_readl(TC7200U_GMAC_MISC_CTRL);
++       val |= 0x100;
++       __raw_writel(val, TC7200U_GMAC_MISC_CTRL);
++
++	mdelay(200);
++
++	val = __raw_readl(TC7200U_SOFT_RESETB_LOW);
++	val |= ((1 << 6) | (1 << 8));
++	__raw_writel(val, TC7200U_SOFT_RESETB_LOW);
++}
++
++static void tc7200u_stage1_unimac_seed(void __iomem *base, u32 cmd_bits)
++{
++	u32 val;
++
++	/* fn_enet_gmac_init_step2: stage GMAC command bits per interface */
++	val = __raw_readl(TC7200U_GMAC_CMD);
++	val |= cmd_bits;
++	__raw_writel(val, TC7200U_GMAC_CMD);
++
++	/*
++	 * fn_enet_gmac_init_step6 register program (observed d60242):
++	 *   reg[0x208] = (reg & 0xfefffbf3) | 0x0000000b
++	 *   reg[0x214] = (reg & 0xffffc000) | 0x00000800
++	 *   reg[0x01c] |= 0x00000283
++	 *   reg[0x020] |= 0x00001800
++	 */
++	val = __raw_readl(base + 0x208);
++	val &= 0xfefffbf3;
++	val |= 0x0000000b;
++	__raw_writel(val, base + 0x208);
++
++	val = __raw_readl(base + 0x214);
++	val &= 0xffffc000;
++	val |= 0x00000800;
++	__raw_writel(val, base + 0x214);
++
++	val = __raw_readl(base + 0x01c);
++	val |= 0x00000283;
++	__raw_writel(val, base + 0x01c);
++
++	val = __raw_readl(base + 0x020);
++	val |= 0x00001800;
++	__raw_writel(val, base + 0x020);
++}
++
++static void tc7200u_quirks(void)
++{
++	bcm3384_viper_quirks();
++	tc7200u_bcm3383_gmac_init();
++
++	/* IF0 lower command bits + IF1 upper command bits. */
++	tc7200u_stage1_unimac_seed(TC7200U_UNIMAC_IF0_BASE, 0x00000003);
++	tc7200u_stage1_unimac_seed(TC7200U_UNIMAC_IF1_BASE, 0x00030000);
++}
++
+ static void bcm63xx_fixup_cpu1(void)
+ {
+ 	/*
+@@ -193,5 +292,6 @@
+ 
+ static const struct bmips_quirk bmips_quirk_list[] = {
+ 	{ "brcm,bcm3368",		&bcm6358_quirks			},
++	{ "technicolor,tc7200u",	&tc7200u_quirks			},
+ 	{ "brcm,bcm3384-viper",		&bcm3384_viper_quirks		},
+ 	{ "brcm,bcm33843-viper",	&bcm3384_viper_quirks		},
+ 	{ "brcm,bcm6328",		&bcm6328_quirks			},
