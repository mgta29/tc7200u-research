#!/usr/bin/env bash
set -euo pipefail

RESEARCH="${RESEARCH:-$HOME/tc7200u-research}"
RESEARCH_NOTES_DIR="${RESEARCH_NOTES_DIR:-$RESEARCH/research/generated}"
OWRT="${OWRT:-$HOME/src/openwrt}"
RAW="$OWRT/bin/targets/bmips/bcm63268/openwrt-bmips-bcm63268-technicolor_tc7200u-initramfs.bin"
NAME_MAP="${NAME_MAP:-${TC7200U_NAME_MAP:-}}"
DEFAULT_REQUEST_NAME="${TC7200U_DEFAULT_REQUEST_NAME:-openwrt-initramfs.bin}"
DEFAULT_RESULT_NAME="${TC7200U_DEFAULT_RESULT_NAME:-$DEFAULT_REQUEST_NAME}"
REQUEST_NAME="${REQUEST_NAME:-${TFTP_REQUEST_NAME:-$DEFAULT_REQUEST_NAME}}"
RESULT_NAME="${RESULT_NAME:-${TFTP_RESULT_NAME:-$DEFAULT_RESULT_NAME}}"
WRAPPED=""

trim_ws() {
  printf '%s' "$1" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//'
}

parse_name_map() {
  local raw="$1"
  local left=""
  local right=""

  [ -n "$raw" ] || return 0

  case "$raw" in
    *"->"*)
      left="${raw%%->*}"
      right="${raw#*->}"
      ;;
    *"="*)
      left="${raw%%=*}"
      right="${raw#*=}"
      ;;
    *" - "*)
      left="${raw%% - *}"
      right="${raw#* - }"
      ;;
    *)
      echo "ERROR: NAME_MAP must be INPUT=RESULT, INPUT->RESULT, or INPUT - RESULT: $raw" >&2
      exit 2
      ;;
  esac

  REQUEST_NAME="$(trim_ws "$left")"
  RESULT_NAME="$(trim_ws "$right")"
}

parse_name_map "$NAME_MAP"
REQUEST_NAME="$(trim_ws "$REQUEST_NAME")"
RESULT_NAME="$(trim_ws "$RESULT_NAME")"

case "$REQUEST_NAME" in
  ""|*/*|*\\*)
    echo "ERROR: request name must be a plain filename: $REQUEST_NAME" >&2
    exit 2
    ;;
esac
case "$RESULT_NAME" in
  ""|*/*|*\\*)
    echo "ERROR: result name must be a plain filename: $RESULT_NAME" >&2
    exit 2
    ;;
esac

WRAPPED="/mnt/c/tftp/$RESULT_NAME"

cmd="${1:-help}"
shift || true

case "$cmd" in
  help|-h|--help)
    echo "TC7200.U helper"
    echo "Commands: help paths status auto wrap state reverse-stage1 check-gates rules selftest"
    echo "Wrap naming: --name-map INPUT=RESULT, INPUT->RESULT, or INPUT - RESULT; or env NAME_MAP/TFTP_REQUEST_NAME/TFTP_RESULT_NAME"
    echo "Package profile: TC7200U_PACKAGE_PROFILE=fastboot (default) or debug"
    echo "Compatibility: build, check, and verify currently run the same safe flow as wrap"
    ;;
  paths)
    echo "RESEARCH=$RESEARCH"
    echo "RESEARCH_NOTES_DIR=$RESEARCH_NOTES_DIR"
    echo "OWRT=$OWRT"
    echo "RAW=$RAW"
    echo "REQUEST_NAME=$REQUEST_NAME"
    echo "RESULT_NAME=$RESULT_NAME"
    echo "WRAPPED=$WRAPPED"
    echo "TC7200U_PACKAGE_PROFILE=${TC7200U_PACKAGE_PROFILE:-fastboot}"
    ;;
  status)
    cd "$RESEARCH"
    echo "== git =="
    git status --short || true
    echo
    echo "== scripts =="
    find scripts -maxdepth 3 -type f | sort
    ;;
  auto|wrap|build|check|verify)
    cd "$RESEARCH"
    exec scripts/tc7200u-auto-build-install-wrap.sh auto "$@"
    ;;
  state)
    cd "$RESEARCH"
    exec scripts/tc7200u-auto-build-install-wrap.sh capture-state "$@"
    ;;
  reverse-stage1|reverse)
    cd "$RESEARCH"
    exec scripts/tc7200u-reverse-stage1.py "$@"
    ;;
  check-gates|gates)
    cd "$RESEARCH"
    exec scripts/tc7200u-auto-build-install-wrap.sh check-gates "$@"
    ;;
  rules)
    echo "1. Build OpenWrt first when source/build output changed."
    echo "2. Run tcwrap."
    echo "3. After CHECK OK: size_ok=True, CFE must request '$REQUEST_NAME' and TFTP serves '/mnt/c/tftp/$RESULT_NAME'."
    echo "4. Keep NAME_MAP / REQUEST_NAME / RESULT_NAME consistent between wrapper and TFTP server."
    echo "5. Use short one-line commands on TTL serial."
    ;;
  selftest)
    cd "$RESEARCH"
    tmp="$(mktemp -d "${TMPDIR:-/tmp}/tc7200u-selftest.XXXXXX")"
    cleanup() {
      case "$tmp" in
        /tmp/tc7200u-selftest.*)
          rm -rf "$tmp"
          ;;
      esac
    }
    trap cleanup EXIT INT TERM

    raw="$tmp/raw.bin"
    wrapped="$tmp/wrapped.bin"
    bad_hcs="$tmp/bad-hcs.bin"
    bad_payload="$tmp/bad-payload.bin"
    printf 'test-payload' > "$raw"

    scripts/tc7200u-a825-wrap.py --input "$raw" --output "$wrapped" --build-time 0x12345678 >/dev/null
    scripts/tc7200u-verify-a825-image.py --raw "$raw" --wrapped "$wrapped" >/dev/null

    cp "$wrapped" "$bad_hcs"
    printf '\000\000' | dd of="$bad_hcs" bs=1 seek=84 conv=notrunc status=none
    if scripts/tc7200u-verify-a825-image.py --raw "$raw" --wrapped "$bad_hcs" >/dev/null 2>&1; then
      echo "FAIL: verifier accepted corrupted HCS" >&2
      exit 1
    fi

    cp "$wrapped" "$bad_payload"
    printf X | dd of="$bad_payload" bs=1 seek=92 conv=notrunc status=none
    if scripts/tc7200u-verify-a825-image.py --raw "$raw" --wrapped "$bad_payload" >/dev/null 2>&1; then
      echo "FAIL: verifier accepted corrupted payload" >&2
      exit 1
    fi

    if scripts/tc7200u-verify-a825-image.py --raw "$raw" --wrapped "$wrapped" --expect-load 0x83000000 >/dev/null 2>&1; then
      echo "FAIL: verifier accepted wrong expected load address" >&2
      exit 1
    fi

    echo "OK: TC7200U script selftest passed"
    ;;
  *)
    echo "ERROR: unknown command: $cmd" >&2
    echo "Run: tc help" >&2
    exit 2
    ;;
esac
