--- a/drivers/net/ethernet/broadcom/genet/bcmgenet.c
+++ b/drivers/net/ethernet/broadcom/genet/bcmgenet.c
@@ -3151,6 +3151,9 @@ static irqreturn_t bcmgenet_isr0(int irq, void *dev_id)
 {
 	struct bcmgenet_priv *priv = dev_id;
+	unsigned int raw_stat;
+	unsigned int raw_mask;
 	unsigned int status;
 	unsigned long flags;
 
@@ -3159,6 +3162,20 @@ static irqreturn_t bcmgenet_isr0(int irq, void *dev_id)
 		~bcmgenet_intrl2_0_readl(priv, INTRL2_CPU_MASK_STATUS);
 
+	/* TC7200.U IRQ13 diagnostic: log ISR0 state and avoid normal ISR0 body. */
+	raw_stat = bcmgenet_intrl2_0_readl(priv, INTRL2_CPU_STAT);
+	raw_mask = bcmgenet_intrl2_0_readl(priv, INTRL2_CPU_MASK_STATUS);
+	status = raw_stat & ~raw_mask;
+	netdev_err(priv->dev,
+		   "TC7200U ISR0GUARD irq=%d raw_stat=0x%08x raw_mask=0x%08x pending=0x%08x periph_stat=0x%08x periph_mask=0x%08x\\n",
+		   irq, raw_stat, raw_mask, status,
+		   __raw_readl((void __iomem *)0xb4e00048),
+		   __raw_readl((void __iomem *)0xb4e0004c));
+	bcmgenet_intrl2_0_writel(priv, status, INTRL2_CPU_CLEAR);
+	return IRQ_HANDLED;
+
 	/* clear interrupts */
 	bcmgenet_intrl2_0_writel(priv, status, INTRL2_CPU_CLEAR);
 
